{
  "manifest_version": 3,
  "name": "FIP",
  "version": "1.1.0",
  "description": "Play FIP and its webradios from the toolbar.",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "FIP",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage", "alarms"],
  "host_permissions": [
    "https://icecast.radiofrance.fr/*",
    "https://api.radiofrance.fr/*"
  ]
}
